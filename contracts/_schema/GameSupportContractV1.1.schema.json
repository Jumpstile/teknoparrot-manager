    "Evidence": { "type": "object", "additionalProperties": false, "required": ["SourceIds", "ProfileFileName", "ProfileXmlSha256", "ProfileSourcePath", "Setup", "Metadata", "FixtureIds"], "properties": { "SourceIds": { "type": "array" }, "ProfileFileName": { "type": "string" }, "ProfileXmlSha256": { "type": "string" }, "ProfileSourcePath": { "type": "string" }, "Setup": { "type": "object" }, "Metadata": { "type": "object" }, "FixtureIds": { "type": "array" } } }
