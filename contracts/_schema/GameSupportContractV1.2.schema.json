{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Jumpstile/teknoparrot-manager/contracts/_schema/GameSupportContractV1.2.schema.json",
  "title": "GameSupportContractV1",
  "description": "Deterministic catalog-only support contract version 1.2.0. Runtime observations are assessment data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ContractId", "SchemaVersion", "ProfileCode", "ProfileFileName", "DisplayName", "VariantTitle", "ProfileRevision", "EmulationProfile", "EmulatorType", "SnapshotId", "CapturedAtUtc", "ContractStatus", "StaticEvidenceLevel", "ReleasePosture", "ClassificationReason", "EvidenceGaps", "LaunchExecutables", "MediaRequirements", "ChdRequirements", "RequiredFixes", "RecommendedFixes", "OptionalFixes", "KnownIncompatibleFixes", "UserOwnedContentRequirements", "TeknoParrotUiOwnedSettingRequirements", "RuntimeValidationRequirements", "RequiredPatches", "ShaderFixes", "BepInExRequirements", "DgVoodoo2Requirements", "ReShadeCompatibility", "CrosshairCompatibility", "ForceFeedbackCompatibility", "GpuLimitations", "KnownRuntimeFixes", "Prerequisites", "TeknoParrotUiOwnership", "SetupPolicy", "Evidence"],
  "properties": {
    "ContractId": { "type": "string", "pattern": "^game-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "SchemaVersion": { "const": "1.2.0" },
    "ProfileCode": { "type": "string", "minLength": 1 },
    "ProfileFileName": { "type": "string", "minLength": 1 },
    "DisplayName": { "type": "string", "minLength": 1 },
    "VariantTitle": { "type": "string" },
    "ProfileRevision": { "type": ["integer", "null"] },
    "EmulationProfile": { "type": "string" },
    "EmulatorType": { "type": "string" },
    "SnapshotId": { "type": "string", "minLength": 1 },
    "CapturedAtUtc": { "type": "string", "minLength": 1 },
    "ContractStatus": { "enum": ["DECLARED", "DEPRECATED"] },
    "StaticEvidenceLevel": { "enum": ["SOURCE_VERIFIED", "SOURCE_INCOMPLETE"] },
    "ReleasePosture": { "$ref": "#/definitions/ReleasePosture" },
    "ClassificationReason": { "type": "string", "minLength": 1 },
    "EvidenceGaps": { "type": "array", "items": { "type": "string" } },
    "LaunchExecutables": { "$ref": "#/definitions/LaunchExecutables" },
    "MediaRequirements": { "$ref": "#/definitions/Domain" },
    "ChdRequirements": { "$ref": "#/definitions/ChdDomain" },
    "RequiredFixes": { "$ref": "#/definitions/Domain" },
    "RecommendedFixes": { "$ref": "#/definitions/Domain" },
    "OptionalFixes": { "$ref": "#/definitions/Domain" },
    "KnownIncompatibleFixes": { "$ref": "#/definitions/Domain" },
    "UserOwnedContentRequirements": { "$ref": "#/definitions/Domain" },
    "TeknoParrotUiOwnedSettingRequirements": { "$ref": "#/definitions/Domain" },
    "RuntimeValidationRequirements": { "$ref": "#/definitions/Domain" },
    "RequiredPatches": { "$ref": "#/definitions/Domain" },
    "ShaderFixes": { "$ref": "#/definitions/Domain" },
    "BepInExRequirements": { "$ref": "#/definitions/Domain" },
    "DgVoodoo2Requirements": { "$ref": "#/definitions/Domain" },
    "ReShadeCompatibility": { "$ref": "#/definitions/Domain" },
    "CrosshairCompatibility": { "$ref": "#/definitions/Domain" },
    "ForceFeedbackCompatibility": { "$ref": "#/definitions/Domain" },
    "GpuLimitations": { "$ref": "#/definitions/Domain" },
    "KnownRuntimeFixes": { "$ref": "#/definitions/Domain" },
    "Prerequisites": { "$ref": "#/definitions/Prerequisites" },
    "TeknoParrotUiOwnership": { "$ref": "#/definitions/Ownership" },
    "SetupPolicy": { "$ref": "#/definitions/SetupPolicy" },
    "Evidence": { "$ref": "#/definitions/Evidence" }
  },
  "definitions": {
    "ReleasePosture": { "enum": ["AUTOMATED_SAFE", "REVIEW_MANUAL", "BLOCKED_UNSUPPORTED", "UNCLASSIFIED"] },
    "DeclarationState": { "enum": ["NOT_DECLARED", "DECLARED", "VERIFIED", "INCOMPATIBLE"] },
    "LaunchExecutables": { "type": "object", "additionalProperties": false, "required": ["Primary", "Alternate", "HasTwoExecutables", "LaunchSecondExecutableFirst", "SecondExecutableArguments", "GamePath", "GamePath2", "Rule", "Evidence"], "properties": { "Primary": { "type": "array", "items": { "type": "string" } }, "Alternate": { "type": "array", "items": { "type": "string" } }, "HasTwoExecutables": { "type": "boolean" }, "LaunchSecondExecutableFirst": { "type": "boolean" }, "SecondExecutableArguments": { "type": "string" }, "GamePath": { "type": "string" }, "GamePath2": { "type": "string" }, "Rule": { "type": "string" }, "Evidence": { "type": "array", "items": { "type": "string" } } } },
    "Domain": { "type": "object", "additionalProperties": false, "required": ["Status", "DeclarationState", "Items", "Evidence", "EvidenceRefs", "AutomationAllowed", "Preconditions", "Ownership", "VerificationRule", "Risk"], "properties": { "Status": { "$ref": "#/definitions/DeclarationState" }, "DeclarationState": { "$ref": "#/definitions/DeclarationState" }, "Items": { "type": "array" }, "Evidence": { "type": "array", "items": { "type": "string" } }, "EvidenceRefs": { "type": "array", "items": { "type": "string" } }, "AutomationAllowed": { "type": "boolean" }, "Preconditions": { "type": "array", "items": { "type": "string" } }, "Ownership": { "type": "string" }, "VerificationRule": { "type": "string" }, "Risk": { "type": "string" } } },
    "ChdDomain": { "allOf": [{ "$ref": "#/definitions/Domain" }, { "type": "object", "required": ["Requirement", "AllowedLocations", "MultipleAllowed"], "properties": { "Requirement": { "type": "string" }, "AllowedLocations": { "type": "array", "items": { "type": "string" } }, "MultipleAllowed": { "type": "boolean" } } }] },
    "Ownership": { "type": "object", "additionalProperties": false, "required": ["Fields", "TpmReadableFields", "TpmWritableFields", "RequiredUserSelection", "RequiredSettings"], "properties": { "Fields": { "type": "array" }, "TpmReadableFields": { "type": "array" }, "TpmWritableFields": { "type": "array" }, "RequiredUserSelection": { "type": "boolean" }, "RequiredSettings": { "$ref": "#/definitions/Domain" } } },
    "SetupPolicy": { "type": "object", "additionalProperties": false, "required": ["Automation", "Classification", "ReleasePosture", "ReasonCode", "BeginnerAction"], "properties": { "Automation": { "enum": ["AUTOMATED", "MANUAL", "BLOCKED"] }, "Classification": { "$ref": "#/definitions/ReleasePosture" }, "ReleasePosture": { "$ref": "#/definitions/ReleasePosture" }, "ReasonCode": { "type": "string" }, "BeginnerAction": { "type": "string" } } },
    "AutomationPolicy": { "type": "object", "additionalProperties": false, "required": ["MayDetectPresence", "MayVerifyPath", "MayVerifyHash", "MayCopyLocalUserOwnedFile", "MayInstallLocalUserOwnedFile", "MaySearchSupplementaryContent", "MayDownload", "MayRedistribute", "MayUseUnverifiedSource"], "properties": { "MayDetectPresence": { "type": "boolean" }, "MayVerifyPath": { "type": "boolean" }, "MayVerifyHash": { "type": "boolean" }, "MayCopyLocalUserOwnedFile": { "type": "boolean" }, "MayInstallLocalUserOwnedFile": { "type": "boolean" }, "MaySearchSupplementaryContent": { "type": "boolean" }, "MayDownload": { "type": "boolean" }, "MayRedistribute": { "type": "boolean" }, "MayUseUnverifiedSource": { "type": "boolean" } } },
    "AppliesWhen": { "type": "object", "additionalProperties": false, "required": ["Match", "ProfileCodes", "EmulationProfiles", "EmulatorTypes"], "properties": { "Match": { "const": "ALL_SPECIFIED" }, "ProfileCodes": { "type": "array", "items": { "type": "string" } }, "EmulationProfiles": { "type": "array", "items": { "type": "string" } }, "EmulatorTypes": { "type": "array", "items": { "type": "string" } } } },
    "Hash": { "type": ["object", "null"], "additionalProperties": false, "required": ["Algorithm", "Value", "EvidenceRef"], "properties": { "Algorithm": { "const": "SHA-256" }, "Value": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }, "EvidenceRef": { "type": "string", "minLength": 1 } } },
    "Derivation": { "type": "object", "additionalProperties": false, "required": ["Kind", "BackendIdentity", "RuleId", "AppliesWhen", "EvidenceRefs", "Reason"], "properties": { "Kind": { "enum": ["PROFILE_DECLARED", "GAMESETUP_DECLARED", "METADATA_DECLARED", "BACKEND_DERIVED", "RUNTIME_CODE_DERIVED"] }, "BackendIdentity": { "type": "string" }, "RuleId": { "type": "string" }, "AppliesWhen": { "$ref": "#/definitions/AppliesWhen" }, "EvidenceRefs": { "type": "array", "items": { "type": "string" } }, "Reason": { "type": "string", "minLength": 1 } } },
    "SupportFileItem": { "type": "object", "additionalProperties": false, "required": ["RequirementId", "RequirementType", "RequirementState", "FileName", "ExpectedRelativePath", "AppliesWhen", "SourceKind", "EvidenceBasis", "Hash", "Derivation", "EvidenceRefs", "VerificationRule", "AutomationPolicy"], "properties": { "RequirementId": { "type": "string", "minLength": 1 }, "RequirementType": { "enum": ["BIOS", "FIRMWARE", "SYSTEM_FILE", "SUPPORT_FILE"] }, "RequirementState": { "enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL", "NOT_DECLARED"] }, "FileName": { "type": "string", "minLength": 1 }, "ExpectedRelativePath": { "type": ["string", "null"] }, "AppliesWhen": { "$ref": "#/definitions/AppliesWhen" }, "SourceKind": { "enum": ["SUPPLEMENTARY_GAMES", "USER_SUPPLIED", "TEKNOPARROT_DISTRIBUTION", "OTHER_EVIDENCED", "UNKNOWN"] }, "EvidenceBasis": { "enum": ["PROFILE_DECLARED", "GAMESETUP_DECLARED", "METADATA_DECLARED", "BACKEND_DERIVED", "RUNTIME_CODE_DERIVED"] }, "Hash": { "$ref": "#/definitions/Hash" }, "Derivation": { "$ref": "#/definitions/Derivation" }, "EvidenceRefs": { "type": "array", "items": { "type": "string" } }, "VerificationRule": { "type": "string", "minLength": 1 }, "AutomationPolicy": { "$ref": "#/definitions/AutomationPolicy" } } },
    "SupportFiles": { "type": "object", "additionalProperties": false, "required": ["DeclarationState", "Items", "EvidenceRefs", "VerificationRule", "AutomationPolicy"], "properties": { "DeclarationState": { "enum": ["DECLARED", "NOT_DECLARED"] }, "Items": { "type": "array", "items": { "$ref": "#/definitions/SupportFileItem" } }, "EvidenceRefs": { "type": "array", "items": { "type": "string" } }, "VerificationRule": { "type": "string" }, "AutomationPolicy": { "$ref": "#/definitions/AutomationPolicy" } } },
    "AdministratorPolicy": { "type": "object", "additionalProperties": false, "required": ["MayDetectPrivilege", "MayRequestElevation", "MayRelaunchElevated", "MayChangePrivilegeConfiguration"], "properties": { "MayDetectPrivilege": { "type": "boolean" }, "MayRequestElevation": { "type": "boolean" }, "MayRelaunchElevated": { "type": "boolean" }, "MayChangePrivilegeConfiguration": { "type": "boolean" } } },
    "Administrator": { "type": "object", "additionalProperties": false, "required": ["RequirementState", "AppliesTo", "Condition", "UserMayContinueWithoutRequirement", "EvidenceRefs", "VerificationRule", "AutomationPolicy"], "properties": { "RequirementState": { "enum": ["REQUIRED", "CONDITIONAL", "NOT_REQUIRED", "NOT_DECLARED"] }, "AppliesTo": { "enum": ["TEKNOPARROT_UI", "GAME_PROCESS", "LAUNCHER_HELPER", "OTHER", null] }, "Condition": { "type": "string" }, "UserMayContinueWithoutRequirement": { "type": "boolean" }, "EvidenceRefs": { "type": "array", "items": { "type": "string" } }, "VerificationRule": { "type": "string" }, "AutomationPolicy": { "$ref": "#/definitions/AdministratorPolicy" } } },
    "ControllerPolicy": { "type": "object", "additionalProperties": false, "required": ["MayDetectDevice", "MayReadInputMappings", "MayWriteInputMappings", "MaySelectInputApi", "MayClaimHardwareSupport"], "properties": { "MayDetectDevice": { "type": "boolean" }, "MayReadInputMappings": { "type": "boolean" }, "MayWriteInputMappings": { "type": "boolean" }, "MaySelectInputApi": { "type": "boolean" }, "MayClaimHardwareSupport": { "type": "boolean" } } },
    "InputApis": { "type": "object", "additionalProperties": false, "required": ["DefaultInputApi", "AlternativeInputApis", "EvidenceRefs"], "properties": { "DefaultInputApi": { "enum": ["DIRECTINPUT", "XINPUT", "RAWINPUT", "MERGED_INPUT", "UNKNOWN"] }, "AlternativeInputApis": { "type": "array", "items": { "enum": ["DIRECTINPUT", "XINPUT", "RAWINPUT", "MERGED_INPUT", "UNKNOWN"] } }, "EvidenceRefs": { "type": "array", "items": { "type": "string" } } } },
    "EmulatorBackend": { "type": "object", "additionalProperties": false, "required": ["EmulationProfile", "EmulatorType", "ControlTransport", "EvidenceRefs"], "properties": { "EmulationProfile": { "type": "string" }, "EmulatorType": { "type": "string" }, "ControlTransport": { "type": "string" }, "EvidenceRefs": { "type": "array", "items": { "type": "string" } } } },
    "ControllerItem": { "type": "object", "additionalProperties": false, "required": ["ControlId", "Name", "BindingTarget", "AnalogType", "ModeConditions", "EvidenceRefs"], "properties": { "ControlId": { "type": "string", "minLength": 1 }, "Name": { "type": "string", "minLength": 1 }, "BindingTarget": { "type": "string", "minLength": 1 }, "AnalogType": { "type": ["string", "null"] }, "ModeConditions": { "type": "object" }, "EvidenceRefs": { "type": "array", "items": { "type": "string" } } } },
    "ControllerSetting": { "type": "object", "additionalProperties": false, "required": ["Name", "Value", "EvidenceRefs"], "properties": { "Name": { "type": "string", "minLength": 1 }, "Value": { "type": "string" }, "EvidenceRefs": { "type": "array", "items": { "type": "string" } } } },
    "Controllers": { "type": "object", "additionalProperties": false, "required": ["RequirementState", "InputApis", "EmulatorBackend", "Controls", "TeknoParrotUiOwnedSettings", "EvidenceRefs", "VerificationRule", "AutomationPolicy"], "properties": { "RequirementState": { "enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL", "NOT_DECLARED"] }, "InputApis": { "$ref": "#/definitions/InputApis" }, "EmulatorBackend": { "$ref": "#/definitions/EmulatorBackend" }, "Controls": { "type": "array", "items": { "$ref": "#/definitions/ControllerItem" } }, "TeknoParrotUiOwnedSettings": { "type": "array", "items": { "$ref": "#/definitions/ControllerSetting" } }, "EvidenceRefs": { "type": "array", "items": { "type": "string" } }, "VerificationRule": { "type": "string" }, "AutomationPolicy": { "$ref": "#/definitions/ControllerPolicy" } } },
    "Prerequisites": { "type": "object", "additionalProperties": false, "required": ["SupportFiles", "Administrator", "Controllers"], "properties": { "SupportFiles": { "$ref": "#/definitions/SupportFiles" }, "Administrator": { "$ref": "#/definitions/Administrator" }, "Controllers": { "$ref": "#/definitions/Controllers" } } },
    "EvidenceEntry": { "type": "object", "additionalProperties": false, "required": ["EvidenceId", "Kind", "Repository", "Commit", "Path", "Selector", "Sha256", "Claim"], "properties": { "EvidenceId": { "type": "string", "minLength": 1 }, "Kind": { "enum": ["PROFILE_DECLARED", "GAMESETUP_DECLARED", "METADATA_DECLARED", "BACKEND_RUNTIME_CODE", "OWNER_REPORT", "GENERATOR_RULE", "CORPUS_MANIFEST"] }, "Repository": { "type": "string" }, "Commit": { "type": "string" }, "Path": { "type": "string", "minLength": 1 }, "Selector": { "type": "string" }, "Sha256": { "type": ["string", "null"] }, "Claim": { "type": "string", "minLength": 1 } } },
    "Evidence": { "type": "object", "additionalProperties": false, "required": ["Corpus", "Entries", "SourceIds", "ProfileFileName", "ProfileXmlSha256", "ProfileSourcePath", "Setup", "Metadata", "FixtureIds"], "properties": { "Corpus": { "type": "object" }, "Entries": { "type": "array", "items": { "$ref": "#/definitions/EvidenceEntry" } }, "SourceIds": { "type": "array", "items": { "type": "string" } }, "ProfileFileName": { "type": "string", "minLength": 1 }, "ProfileXmlSha256": { "type": "string", "minLength": 1 }, "ProfileSourcePath": { "type": "string" }, "Setup": { "type": "object" }, "Metadata": { "type": "object" }, "FixtureIds": { "type": "array", "items": { "type": "string" } } } }
  }
}
