{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Jumpstile/teknoparrot-manager/contracts/_schema/TpmReleaseCatalogDeltaV1.schema.json",
  "title": "TPM Release Catalog Delta V1",
  "description": "Machine-generated profile identity delta between a snapshot and the one before it. The counts and lists are the data; scripts\\Test-TpmReleaseCatalogSnapshot.ps1 checks them against contracts\\snapshots\\CURRENT-SNAPSHOT-PIN.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["HistoricalSourceCommit", "HistoricalProfileCount", "CurrentProfileCount", "AddedProfileCount", "RemovedProfileCount", "SemanticChangedProfileCount", "SemanticUnchangedProfileCount", "RawByteDifferentProfileCount", "FormattingOnlyChangedProfileCount", "Added", "Removed", "Changed", "Unchanged"],
  "properties": {
    "HistoricalSourceCommit": { "type": "string", "minLength": 1 },
    "HistoricalSnapshotId": { "type": "string", "minLength": 1 },
    "HistoricalProfileCount": { "type": "integer", "minimum": 0 },
    "CurrentProfileCount": { "type": "integer", "minimum": 0 },
    "AddedProfileCount": { "type": "integer", "minimum": 0 },
    "RemovedProfileCount": { "type": "integer", "minimum": 0 },
    "SemanticChangedProfileCount": { "type": "integer", "minimum": 0 },
    "SemanticUnchangedProfileCount": { "type": "integer", "minimum": 0 },
    "RawByteDifferentProfileCount": { "type": "integer", "minimum": 0 },
    "FormattingOnlyChangedProfileCount": { "type": "integer", "minimum": 0 },
    "Added": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "Removed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "Changed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "Unchanged": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
