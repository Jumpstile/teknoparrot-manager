{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Jumpstile/teknoparrot-manager/contracts/_schema/GameSupportContractRegistryV1.3.schema.json",
  "title": "GameSupportContractRegistryV1",
  "description": "Deterministic catalog registry for GameSupportContractV1 version 1.3.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["RegistryId", "SchemaVersion", "SnapshotId", "CapturedAtUtc", "Source", "ExpectedProfileCount", "ContractCount", "ClassificationTotals", "BackendDerivationAudit", "ReleaseGate", "Contracts"],
  "properties": {
    "RegistryId": { "const": "TPM-GAME-SUPPORT-CONTRACTS" },
    "SchemaVersion": { "const": "1.3.0" },
    "SnapshotId": { "type": "string", "minLength": 1 },
    "CapturedAtUtc": { "type": "string", "minLength": 1 },
    "Source": { "type": "object", "additionalProperties": false, "required": ["Repository", "Commit", "ProfileRoot"], "properties": { "Repository": { "type": "string" }, "Commit": { "type": "string" }, "ProfileRoot": { "type": "string" } } },
    "ExpectedProfileCount": { "type": ["integer", "null"] },
    "ContractCount": { "type": "integer", "minimum": 0 },
    "ClassificationTotals": { "type": "object" },
    "BackendDerivationAudit": { "type": "array", "items": { "type": "object" } },
    "ReleaseGate": { "type": "object" },
    "Contracts": { "type": "array", "items": { "$ref": "GameSupportContractV1.3.schema.json" } }
  }
}
