{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Jumpstile/teknoparrot-manager/contracts/_schema/GameSupportContractV1.schema.json",
  "title": "GameSupportContractV1",
  "description": "Catalog-wide per-profile support contract. NOT_DECLARED is unknown and never authorizes automation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ContractId", "SchemaVersion", "ProfileCode", "ProfileFileName", "DisplayName", "VariantTitle",
    "ProfileRevision", "EmulationProfile", "EmulatorType", "SnapshotId", "CapturedAtUtc", "ContractStatus",
    "EvidenceConfidence", "ReleasePosture", "AutomationAllowed", "ClassificationReason", "EvidenceGaps",
    "LaunchExecutables", "MediaRequirements", "ChdRequirements", "RequiredFixes", "RecommendedFixes",
    "OptionalFixes", "KnownIncompatibleFixes", "UserOwnedContentRequirements",
    "TeknoParrotUiOwnedSettingRequirements", "RuntimeValidationRequirements", "RequiredPatches", "ShaderFixes",
    "BepInExRequirements", "DgVoodoo2Requirements", "ReShadeCompatibility", "CrosshairCompatibility",
    "ForceFeedbackCompatibility", "GpuLimitations", "KnownRuntimeFixes", "TeknoParrotUiOwnership",
    "SetupPolicy", "RuntimeValidation", "Evidence"
  ],
  "properties": {
    "ContractId": { "type": "string", "pattern": "^game-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "SchemaVersion": { "const": "1.1.0" },
    "ProfileCode": { "type": "string", "minLength": 1 },
    "ProfileFileName": { "type": "string", "minLength": 1 },
    "DisplayName": { "type": "string", "minLength": 1 },
    "VariantTitle": { "type": "string" },
    "ProfileRevision": { "type": ["integer", "null"] },
    "EmulationProfile": { "type": "string" },
    "EmulatorType": { "type": "string" },
    "SnapshotId": { "type": "string", "minLength": 1 },
    "CapturedAtUtc": { "type": "string", "minLength": 1 },
    "ContractStatus": { "enum": ["DECLARED", "VERIFIED", "DEPRECATED"] },
    "EvidenceConfidence": { "enum": ["SourceVerified", "ExperimentVerified", "HardwareVerified", "ProductionVerified"] },
    "ReleasePosture": { "$ref": "#/definitions/ReleasePosture" },
    "AutomationAllowed": { "type": "boolean" },
    "ClassificationReason": { "type": "string", "minLength": 1 },
    "EvidenceGaps": { "type": "array", "items": { "type": "string" } },
    "LaunchExecutables": {
      "type": "object", "additionalProperties": false,
      "required": ["Primary", "Alternate", "HasTwoExecutables", "LaunchSecondExecutableFirst", "SecondExecutableArguments", "GamePath", "GamePath2", "Rule", "Evidence"],
      "properties": {
        "Primary": { "type": "array", "items": { "type": "string" } },
        "Alternate": { "type": "array", "items": { "type": "string" } },
        "HasTwoExecutables": { "type": "boolean" },
        "LaunchSecondExecutableFirst": { "type": "boolean" },
        "SecondExecutableArguments": { "type": "string" },
        "GamePath": { "type": "string" },
        "GamePath2": { "type": "string" },
        "Rule": { "type": "string" },
        "Evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "MediaRequirements": { "$ref": "#/definitions/Domain" },
    "ChdRequirements": {
      "allOf": [
        { "$ref": "#/definitions/Domain" },
        {
          "type": "object",
          "required": ["Requirement", "AllowedLocations", "MultipleAllowed"],
          "properties": {
            "Requirement": { "type": "string" },
            "AllowedLocations": { "type": "array", "items": { "type": "string" } },
            "MultipleAllowed": { "type": "boolean" }
          }
        }
      ]
    },
    "RequiredFixes": { "$ref": "#/definitions/Domain" },
    "RecommendedFixes": { "$ref": "#/definitions/Domain" },
    "OptionalFixes": { "$ref": "#/definitions/Domain" },
    "KnownIncompatibleFixes": { "$ref": "#/definitions/Domain" },
    "UserOwnedContentRequirements": { "$ref": "#/definitions/Domain" },
    "TeknoParrotUiOwnedSettingRequirements": { "$ref": "#/definitions/Domain" },
    "RuntimeValidationRequirements": { "$ref": "#/definitions/Domain" },
    "RequiredPatches": { "$ref": "#/definitions/Domain" },
    "ShaderFixes": { "$ref": "#/definitions/Domain" },
    "BepInExRequirements": { "$ref": "#/definitions/Domain" },
    "DgVoodoo2Requirements": { "$ref": "#/definitions/Domain" },
    "ReShadeCompatibility": { "$ref": "#/definitions/Domain" },
    "CrosshairCompatibility": { "$ref": "#/definitions/Domain" },
    "ForceFeedbackCompatibility": { "$ref": "#/definitions/Domain" },
    "GpuLimitations": { "$ref": "#/definitions/Domain" },
    "KnownRuntimeFixes": { "$ref": "#/definitions/Domain" },
    "TeknoParrotUiOwnership": {
      "type": "object", "additionalProperties": false,
      "required": ["Fields", "TpmReadableFields", "TpmWritableFields", "RequiredUserSelection", "RequiredSettings"],
      "properties": {
        "Fields": { "type": "array", "items": { "type": "string" } },
        "TpmReadableFields": { "type": "array", "items": { "type": "string" } },
        "TpmWritableFields": { "type": "array", "items": { "type": "string" } },
        "RequiredUserSelection": { "type": "boolean" },
        "RequiredSettings": { "$ref": "#/definitions/Domain" }
      }
    },
    "SetupPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["Automation", "Classification", "ReleasePosture", "AutomationAllowed", "ReasonCode", "BeginnerAction"],
      "properties": {
        "Automation": { "enum": ["AUTOMATED", "MANUAL", "BLOCKED"] },
        "Classification": { "$ref": "#/definitions/ReleasePosture" },
        "ReleasePosture": { "$ref": "#/definitions/ReleasePosture" },
        "AutomationAllowed": { "type": "boolean" },
        "ReasonCode": { "type": "string", "minLength": 1 },
        "BeginnerAction": { "type": "string" }
      }
    },
    "RuntimeValidation": {
      "type": "object", "additionalProperties": false,
      "required": ["Status", "Required", "Rules", "Evidence"],
      "properties": {
        "Status": { "enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED"] },
        "Required": { "type": "boolean" },
        "Rules": { "type": "array", "items": { "type": "string" } },
        "Evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["SourceIds", "ProfileFileName", "ProfileXmlSha256", "ProfileSourcePath", "Setup", "Metadata", "FixtureIds"],
      "properties": {
        "SourceIds": { "type": "array", "items": { "type": "string" } },
        "ProfileFileName": { "type": "string", "minLength": 1 },
        "ProfileXmlSha256": { "type": "string", "minLength": 1 },
        "ProfileSourcePath": { "type": "string" },
        "Setup": { "type": "object" },
        "Metadata": { "type": "object" },
        "FixtureIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "definitions": {
    "ReleasePosture": { "enum": ["AUTOMATED_SAFE", "REVIEW_MANUAL", "BLOCKED_UNSUPPORTED", "UNCLASSIFIED"] },
    "DeclarationState": { "enum": ["NOT_DECLARED", "DECLARED", "VERIFIED", "INCOMPATIBLE"] },
    "Domain": {
      "type": "object", "additionalProperties": false,
      "required": ["Status", "DeclarationState", "Items", "Evidence", "EvidenceRefs", "AutomationAllowed", "Preconditions", "Ownership", "VerificationRule", "Risk"],
      "properties": {
        "Status": { "$ref": "#/definitions/DeclarationState" },
        "DeclarationState": { "$ref": "#/definitions/DeclarationState" },
        "Items": { "type": "array" },
        "Evidence": { "type": "array", "items": { "type": "string" } },
        "EvidenceRefs": { "type": "array", "items": { "type": "string" } },
        "AutomationAllowed": { "type": "boolean" },
        "Preconditions": { "type": "array", "items": { "type": "string" } },
        "Ownership": { "type": "string" },
        "VerificationRule": { "type": "string" },
        "Risk": { "type": "string" }
      }
    }
  }
}
