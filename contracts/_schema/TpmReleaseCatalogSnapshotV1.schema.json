{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Jumpstile/teknoparrot-manager/contracts/_schema/TpmReleaseCatalogSnapshotV1.schema.json",
  "title": "TPM Release Catalog Snapshot V1",
  "description": "Immutable provenance and content manifest for a captured TeknoParrot catalog (an upstream release asset, or an installed folder). The accepted values are pinned in contracts\\snapshots\\CURRENT-SNAPSHOT-PIN.json and checked by scripts\\Test-TpmReleaseCatalogSnapshot.ps1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["SnapshotSchemaVersion", "SnapshotId", "CapturedAtUtc", "SnapshotKind", "Release", "SourceProof", "CatalogCounts", "CatalogRoots", "SemanticRootDigests", "Files", "SemanticComparison", "DeltaManifest", "ReleaseEvidence", "MutabilityRecord", "ParserVersion", "ProvenanceDiscrepancy"],
  "properties": {
    "SnapshotSchemaVersion": { "const": "1.0.0" },
    "SnapshotId": { "type": "string", "pattern": "^TPM-GAME-SUPPORT-RELEASE-\\d+(\\.\\d+){3}-ASSET-[0-9A-F]{8}$" },
    "CapturedAtUtc": { "type": "string", "minLength": 1 },
    "SnapshotKind": { "const": "TPM_CURRENT_RELEASE_CATALOG" },
    "SourceKind": { "const": "INSTALLED_FOLDER" },
    "Release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Version", "Tag", "ReleaseId", "AssetName", "AssetUrl", "AssetSize", "AssetSha256", "AssetUpdatedAt"],
      "properties": {
        "Version": { "type": "string", "pattern": "^\\d+(\\.\\d+){3}$" },
        "Tag": { "type": "string", "minLength": 1 },
        "ReleaseId": { "type": "integer", "minimum": 0 },
        "AssetName": { "type": "string", "minLength": 1 },
        "AssetUrl": { "type": "string" },
        "AssetSize": { "type": "integer", "minimum": 1 },
        "AssetSha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
        "AssetUpdatedAt": { "type": "string", "minLength": 1 }
      }
    },
    "SourceProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Repository", "Commit", "Tree", "Role"],
      "properties": {
        "Repository": { "type": "string", "minLength": 1 },
        "Commit": { "type": "string", "minLength": 1 },
        "Tree": { "type": "string" },
        "Role": { "type": "string", "minLength": 1 }
      }
    },
    "CatalogCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["GameProfiles", "GameSetup", "Metadata", "TotalFiles"],
      "properties": {
        "GameProfiles": { "type": "integer", "minimum": 1 },
        "GameSetup": { "type": "integer", "minimum": 0 },
        "Metadata": { "type": "integer", "minimum": 0 },
        "TotalFiles": { "type": "integer", "minimum": 1 }
      }
    },
    "CatalogRoots": { "type": "array", "minItems": 1, "items": { "enum": ["GameProfiles", "GameSetup", "Metadata"] } },
    "SemanticRootDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["GameProfiles"],
      "properties": {
        "GameProfiles": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
        "GameSetup": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
        "Metadata": { "pattern": "^[0-9a-f]{64}$", "type": "string" }
      }
    },
    "Files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["RelativePath", "Root", "FileName", "Length", "Sha256", "SemanticSha256"],
        "properties": {
          "RelativePath": { "type": "string", "pattern": "^(GameProfiles|GameSetup|Metadata)/[^/]+\\.(xml|json)$" },
          "Root": { "enum": ["GameProfiles", "GameSetup", "Metadata"] },
          "FileName": { "type": "string", "minLength": 1 },
          "ProfileCode": { "type": ["string", "null"] },
          "Length": { "type": "integer", "minimum": 0 },
          "Sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
          "SemanticSha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" }
        }
      }
    },
    "SemanticComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Valid", "ComparedFileCount", "MismatchCount", "ProofCommit"],
      "properties": {
        "Valid": { "type": "boolean" },
        "ComparedFileCount": { "type": "integer", "minimum": 0 },
        "MismatchCount": { "type": "integer", "minimum": 0 },
        "ProofCommit": { "type": "string", "minLength": 1 },
        "Note": { "type": "string" }
      }
    },
    "DeltaManifest": { "const": "delta.json" },
    "ReleaseEvidence": { "const": "release-evidence.json" },
    "MutabilityRecord": { "const": "asset-mutability.json" },
    "ParserVersion": { "const": "TPM-RELEASE-SNAPSHOT-PARSER-1" },
    "ProvenanceDiscrepancy": { "type": "string", "minLength": 1 }
  }
}
