# Distribution ZIPs -- these go to GitHub Releases, not git history
TeknoParrot Manager*.zip
TeknoParrot.Manager*.zip

# Third-party DLLs -- proprietary, user provides; see README.md's ReShade
# Visual Enhancements / dgVoodoo2 Legacy Compatibility sections for bundling notes
ReShade/*
dgVoodoo2/

# FFB plugin DLL cache -- auto-downloaded live from GitHub each run, never bundled
FFBPlugin/

# BepInEx update cache -- auto-downloaded live from GitHub each run, never bundled
BepInExCache/

# Local instruction file -- contains local paths, not for public repos
CLAUDE.md

# User-specific generated files
config.json
TeknoParrot-Manager.config.json
TeknoParrot-Manager.overrides.json
TeknoParrot-Manager-ActionItems.txt
TeknoParrot-Manager-controls.txt
TeknoParrot-Manager-crosshairs.json
*.log

# LaunchBox backup folder -- user data, written at runtime, never tracked
LaunchBoxBackups/

# Check for Updates backup folder -- written at runtime, never tracked
UpdateBackups/

# TPM Certification Suite output -- scripts/Run-TPM-Tests.ps1 places this as a
# sibling of the repo by default (Join-Path $repoParent "TPM-TestHarness"), so
# it should never normally land here. Ignored defensively anyway: a run with a
# mistaken -HarnessRoot could otherwise leave real report/backup output as
# untracked noise, which is exactly what happened once during early manual
# testing (empty leftover TPM-TestHarness/Reports/ folder, confirmed harmless
# and unrelated to any code path, cleaned up after investigation).
TPM-TestHarness/

# Local HTML crosshair preview -- generated artifact, not a repo doc
TeknoParrot-Crosshairs-Preview.html

# Downloaded Eggman dat ZIP -- fetched live each run, never bundled/tracked
TeknoParrot.Collection*.zip

# Local forum-post draft -- not part of the project, never meant to be public
forum-post-beta-testing.txt

# clawpatch local tool state -- not part of the project, machine-local cache
.clawpatch/

# Local assistant workspace state -- not part of the project, machine-local cache
.claude/
/pester-results.xml
/TestResults.xml
# Quality gate Pester result files (one per test run, written beside the gate report)
pester-*-results.xml
/TeknoParrot-Manager-game-notes.txt
/TeknoParrotManager-Support-*.zip

# Lane and fix-run artifacts -- task notes, result reports and hash lists name work-tree paths and belong in the lane folder, never in the repo
/FIX*-RESULT.md
/FIX*-HASHES.json
/FIX*-TASK.md
/FIX*.diff

# Certification smoke harness: settings-file restore record and its temporary files (user-specific, deleted after a verified restore)
TeknoParrot-Manager.config.json.smoke-restore.json
.TeknoParrot-Manager.config.json.*.tmp
.TeknoParrot-Manager.config.json.smoke-restore.json.*.tmp
